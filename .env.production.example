APP_NAME="Corpo Survey Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=survey_management
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=survey_mgmt_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TWO_FACTOR_ENFORCED=true
SESSION_ABSOLUTE_LIFETIME=480

RETENTION_SOFT_DELETE_DAYS=90

CAPTCHA_DRIVER=recaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# All secrets below must come from a real secrets manager (AWS Secrets Manager,
# Vault, etc.) injected at deploy time — never stored in this file or in git.
# DB_PASSWORD, MAIL_USERNAME/PASSWORD, AWS_* keys, CAPTCHA_SECRET_KEY.

CONTACT_EMAIL="hello@example.com"
CONTACT_PHONE="+880 1XXX-XXXXXX"
